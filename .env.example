# Environment Configuration for Server Room AC Overheat Predictor
# Copy this file to .env and fill in strong secrets before running.
# NEVER commit .env to version control.

# Fernet symmetric key for encrypting Gmail SMTP App Passwords in SQLite.
# Generate a new key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_URLSAFE_BASE64_FERNET_KEY

# Operator access key required for modifying SMTP and system settings.
# Change this to a strong secret in deployment.
OPERATOR_ACCESS_KEY=change-this-operator-passcode

# SQLite database file path (inside container or local path)
DATABASE_PATH=./data/ac_predictor.db

# Trained ML model and evaluation artifact paths
MODEL_PATH=./ml/models/ac_failure_model.joblib
METRICS_PATH=./ml/models/model_evaluation.json

# FastAPI backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000

# Simulator defaults
SIMULATOR_INTERVAL_SECONDS=3
SIMULATOR_ENABLED=true

# Alert engine defaults
ALERT_THRESHOLD=0.70
ALERT_COOLDOWN_MINUTES=15
ALERT_POLL_INTERVAL_SECONDS=3

# Dashboard defaults
DASHBOARD_REFRESH_SECONDS=3
